# Local development. On Render, PORT is set automatically — do not set it.
PORT=4000

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Comma-separated frontend origins, no trailing slash.
# Local: http://localhost:5173,http://localhost:3000
# Production: https://alcaster-w6n5.vercel.app,https://alcaster-wjnn.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://alcaster-w6n5.vercel.app,https://alcaster-wjnn.vercel.app

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alcaster?retryWrites=true&w=majority

# Demo operator seeded on boot.
DEMO_EMAIL=rajat@alcaster.com
DEMO_PASSWORD=change-me

# lax for local same-origin/proxy. none when the Vite app and API are on different domains (Vercel + Render).
COOKIE_SAMESITE=lax
