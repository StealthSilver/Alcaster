# Public site origin used for canonical URLs, Open Graph, and Twitter metadata.
# No trailing slash. Required for correct absolute social-preview URLs in production.
#
# Example:
#   NEXT_PUBLIC_SITE_URL=https://alcaster-wjnn.vercel.app
#
# When unset, the app falls back to http://localhost:3000 (local-dev placeholder only).
NEXT_PUBLIC_SITE_URL=https://alcaster-wjnn.vercel.app

